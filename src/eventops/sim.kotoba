(ns eventops.sim
  "Demo driver -- `kbb -M:run`. Walks a clean event-record logging
  request through intake -> advise -> govern -> decide -> approval ->
  commit at phase 1 (assisted-logging, always approval), then re-runs the
  same op at phase 3 (supervised-auto, clean + high confidence ->
  auto-commit), then a venue-operation-scheduling request and a
  low-cost vendor-order coordination naming a verified vendor (both
  auto-commit clean at phase 3), then a high-cost vendor-order (ALWAYS
  escalates regardless of phase), then a safety-concern flag (ALWAYS
  escalates, at any phase -- approve, then commit), then HARD-hold
  scenarios: an unregistered venue, a venue registered but not yet
  verified, a vendor-order naming an unverified vendor, a proposal whose
  own `:effect` is not `:propose`, and a proposal that has drifted into
  the permanently-excluded venue-occupancy-limit-override/fire-code/
  egress-clearance-finalization scope."
  (:require [langgraph.graph :as g]
            [eventops.advisor :as advisor]
            [eventops.store :as store]
            [eventops.operation :as op]))

(defn- exec-op [actor tid request context]
  (g/run* actor {:request request :context context} {:thread-id tid}))

(defn- approve! [actor tid]
  (g/run* actor {:approval {:status :approved :by "event-operations-coordinator-1"}} {:thread-id tid :resume? true}))

(defn -main [& _]
  (let [db (store/seed-db)
        coordinator-phase-1 {:actor-id "coord-1" :actor-role :event-operations-coordinator :phase 1}
        coordinator-phase-3 {:actor-id "coord-1" :actor-role :event-operations-coordinator :phase 3}
        actor (op/build db)]

    (println "== log-event-record venue-1 (phase 1, escalates -- human approves) ==")
    (let [r (exec-op actor "t1" {:op :log-event-record :venue-id "venue-1"
                                  :patch {:exhibitor-checkins 42 :badges-issued 310 :attendance-delta 12}} coordinator-phase-1)]
      (println r)
      (println "-- human event-operations coordinator approves --")
      (println (approve! actor "t1")))

    (println "\n== log-event-record venue-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t2" {:op :log-event-record :venue-id "venue-1"
                                  :patch {:exhibitor-checkins 30 :badges-issued 210 :attendance-delta 8}} coordinator-phase-3))

    (println "\n== schedule-venue-operation venue-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t3" {:op :schedule-venue-operation :venue-id "venue-1"
                                  :patch {:hall "hall-b" :date "2026-08-20" :window "06:00-10:00" :activity "exhibitor-load-in"}} coordinator-phase-3))

    (println "\n== coordinate-vendor-order venue-1, low cost, verified vendor (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t4" {:op :coordinate-vendor-order :venue-id "venue-1"
                                  :patch {:item "AV staging package" :quantity 1 :estimated-cost 420.0
                                          :vendor-id "vendor-1"}} coordinator-phase-3))

    (println "\n== coordinate-vendor-order venue-1, HIGH cost (ALWAYS escalates, even at phase 3) ==")
    (let [r (exec-op actor "t5" {:op :coordinate-vendor-order :venue-id "venue-1"
                                 :patch {:item "main-stage AV + rigging package" :quantity 1 :estimated-cost 3200.0
                                         :vendor-id "vendor-1"}} coordinator-phase-3)]
      (println r)
      (println "-- human event-operations coordinator reviews & approves --")
      (println (approve! actor "t5")))

    (println "\n== flag-safety-concern venue-1 (ALWAYS escalates, even at phase 3) ==")
    (let [r (exec-op actor "t6" {:op :flag-safety-concern :venue-id "venue-1"
                                 :patch {:concern "hall-b nearing posted occupancy limit during peak exhibitor load-in, one egress route partially obstructed by crates" :confidence 0.92}} coordinator-phase-3)]
      (println r)
      (println "-- human event-operations coordinator reviews & approves --")
      (println (approve! actor "t6")))

    (println "\n== log-event-record venue-99 (unregistered venue -> HARD hold) ==")
    (println (exec-op actor "t7" {:op :log-event-record :venue-id "venue-99"
                                  :patch {:exhibitor-checkins 0}} coordinator-phase-3))

    (println "\n== log-event-record venue-3 (registered but unverified -> HARD hold) ==")
    (println (exec-op actor "t8" {:op :log-event-record :venue-id "venue-3"
                                  :patch {:exhibitor-checkins 10}} coordinator-phase-3))

    (println "\n== coordinate-vendor-order venue-1, vendor-2 unverified (-> HARD hold) ==")
    (println (exec-op actor "t9" {:op :coordinate-vendor-order :venue-id "venue-1"
                                  :patch {:item "catering for opening reception" :quantity 1 :estimated-cost 300.0
                                          :vendor-id "vendor-2"}} coordinator-phase-3))

    (println "\n== schedule-venue-operation venue-1, advisor attempts direct actuation (:effect :commit) -> HARD hold ==")
    (let [actor-direct (op/build db {:advisor (reify advisor/Advisor
                                                (-advise [_ _ req]
                                                  (assoc (advisor/infer nil req) :effect :commit)))})]
      (println (exec-op actor-direct "t10" {:op :schedule-venue-operation :venue-id "venue-1"
                                           :patch {:hall "hall-a" :date "2026-08-22"}} coordinator-phase-3)))

    (println "\n== log-event-record venue-1, advisor drifts into occupancy-override/fire-code-clearance-finalization scope -> HARD hold, permanent ==")
    (println (exec-op actor "t11" {:op :log-event-record :venue-id "venue-1"
                                   :out-of-scope? true
                                   :patch {}} coordinator-phase-3))

    (println "\n== audit ledger ==")
    (doseq [f (store/ledger db)] (println f))

    (println "\n== committed coordination log ==")
    (doseq [r (store/coordination-log db)] (println r))))
